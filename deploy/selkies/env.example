# Fill operator paths; these deliberately have no invented Unraid mount paths.
PORTAL_IMAGE=ghcr.io/macacagames/openpencil-viewer:latest
PORTAL_UID=99
PORTAL_GID=100
PORTAL_CONFIG_DIR=
GOOGLE_OAUTH_FILE=
NAS_DESIGNS_PATH=
NAS_EXPECTED_SOURCE=
LOCAL_STATE_PATH=
# Full PCI address, e.g. the address printed by lspci; auto is also supported.
GPU_RENDER_PCI=auto
GPU_ENCODE_PCI=auto
GPU_RENDER_MODE=auto
# auto / vaapi / cpu. vaapi refuses startup when the synthetic encode fails.
GPU_ENCODER_MODE=auto
DRM_RENDER_GID=
DRM_CARD_GID=
