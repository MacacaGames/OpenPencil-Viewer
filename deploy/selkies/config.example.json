{
  "version": 1,
  "mode": "session-edit",
  "environment": "production",
  "origin": "https://openpencil.macaca.games",
  "host": "0.0.0.0",
  "port": 3000,
  "identityProvider": "google-oidc",
  "authorizationMode": "google-mount",
  "viewerMode": "selkies",
  "allowedHostedDomains": ["macaca.games"],
  "statePath": "/state/unraid-google-mount.sqlite",
  "webPath": "/app/dist/web",
  "roots": [
    {
      "id": "designs",
      "label": "Designs",
      "path": "/data/designs"
    }
  ],
  "maxFileBytes": 536870912,
  "maxDownloads": 4,
  "scanIntervalMs": 60000,
  "remote": {
    "runtimePath": "/state/remote",
    "appPort": 8085,
    "streamPort": 8086,
    "maxSessions": 32,
    "maxSessionsPerAccount": 4,
    "blankPrewarmIdleMs": 60000,
    "maxWidth": 1920,
    "maxHeight": 1080,
    "maxPixels": 2073600,
    "maxDpi": 192,
    "disconnectGraceMs": 3000
  },
  "allowClientEditor": false
}
